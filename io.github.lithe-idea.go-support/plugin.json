{
  "schemaVersion": 0,
  "id": "io.github.lithe-idea.go-support",
  "displayName": "Go Support",
  "version": "1.4.0",
  "pluginAPIVersion": 0,
  "requires": {
    "backend": 0,
    "buildSystems": 0,
    "commandInstallers": 0,
    "debugAdapters": 0,
    "languageServers": 0,
    "languages": 0,
    "projectGenerators": 0,
    "runConfigurationTypes": 0,
    "settings": 0,
    "toolDefinitions": 0,
    "ui": 0
  },
  "requiresTools": [
    "go"
  ],
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": [
    "backend.launch",
    "commands.install",
    "debug.launch",
    "languageServer.launch",
    "process.build",
    "project.generate",
    "ui.contribute",
    "workspace.directoryMarks",
    "workspace.metadata",
    "workspace.search"
  ],
  "activationEvents": [
    "onBuildSystem:go",
    "onDebug:delve",
    "onLanguage:go",
    "onWorkspaceOpen"
  ],
  "settings": [
    {
      "id": "goExecutable",
      "type": "file",
      "title": "Go executable",
      "description": "The go program used to read the module and to build, vet, test and run it. Leave empty to use go from PATH.",
      "default": "",
      "placeholder": "Automatic: go on PATH",
      "effect": "reload",
      "page": {
        "buildSystemID": "go"
      },
      "section": "Go toolchain"
    },
    {
      "id": "delveExecutable",
      "type": "file",
      "title": "Delve executable",
      "description": "The local Delve program used for debugging. Leave empty to look for dlv on PATH, then in plugin installation directories.",
      "default": "",
      "placeholder": "Automatic: find dlv",
      "effect": "nextRun",
      "section": "Go toolchain"
    },
    {
      "id": "staticcheck",
      "type": "boolean",
      "title": "Staticcheck analyses",
      "description": "Report staticcheck's additional checks as diagnostics. Uses more CPU and memory on large modules.",
      "default": false,
      "effect": "immediate",
      "page": {
        "languageID": "go"
      },
      "section": "gopls"
    },
    {
      "id": "gofumpt",
      "type": "boolean",
      "title": "Format with gofumpt",
      "description": "Apply gofumpt's stricter rules when formatting Go files.",
      "default": false,
      "effect": "immediate",
      "page": {
        "languageID": "go"
      },
      "section": "gopls"
    },
    {
      "id": "usePlaceholders",
      "type": "boolean",
      "title": "Parameter placeholders in completion",
      "description": "Insert placeholders for a function's parameters when completing a call.",
      "default": false,
      "effect": "immediate",
      "page": {
        "languageID": "go"
      },
      "section": "gopls"
    },
    {
      "id": "hoverKind",
      "type": "enum",
      "title": "Hover documentation",
      "description": "How much documentation a hover shows.",
      "default": "FullDocumentation",
      "effect": "immediate",
      "page": {
        "languageID": "go"
      },
      "section": "gopls",
      "options": [
        {
          "value": "FullDocumentation",
          "title": "Full documentation"
        },
        {
          "value": "SynopsisDocumentation",
          "title": "First sentence"
        },
        {
          "value": "SingleLine",
          "title": "One line"
        },
        {
          "value": "NoDocumentation",
          "title": "Signature only"
        }
      ]
    }
  ],
  "settingRegions": [
    {
      "id": "language",
      "page": {
        "languageID": "go"
      },
      "keywords": [
        "gopls",
        "hover",
        "completion",
        "placeholders",
        "gofumpt",
        "formatting",
        "staticcheck",
        "preview"
      ],
      "view": {
        "function": "settings.view"
      }
    },
    {
      "id": "toolchain",
      "page": {
        "buildSystemID": "go"
      },
      "keywords": [
        "go executable",
        "toolchain",
        "lookup order",
        "PATH",
        "GOROOT"
      ],
      "view": {
        "function": "settings.view"
      }
    }
  ],
  "languages": [
    {
      "id": "go",
      "displayName": "Go",
      "fileExtensions": [
        "go"
      ],
      "projectFileNames": [
        "go.mod",
        "go.work"
      ],
      "dependencies": {
        "managementFileNames": [
          "go.mod",
          "go.sum",
          "go.work",
          "go.work.sum",
          "vendor/modules.txt"
        ],
        "projectDependencyPaths": [
          "vendor"
        ]
      }
    }
  ],
  "languageServers": [
    {
      "languageID": "go",
      "languageIdentifier": "go",
      "launch": {
        "kind": "systemCommand",
        "commands": [
          "gopls"
        ]
      },
      "arguments": [],
      "validationArguments": [
        "version"
      ],
      "workspaceConfiguration": {
        "gopls": {
          "staticcheck": "${setting:staticcheck}",
          "gofumpt": "${setting:gofumpt}",
          "usePlaceholders": "${setting:usePlaceholders}",
          "hoverKind": "${setting:hoverKind}"
        }
      },
      "indexingExclusions": {
        "section": "gopls.directoryFilters",
        "entry": "-${path}",
        "rootEntry": "-",
        "default": [
          "-**/node_modules"
        ],
        "pathSyntax": "glob"
      }
    }
  ],
  "buildSystems": [
    {
      "id": "go",
      "displayName": "Go Modules",
      "detection": {
        "markers": [
          "go.mod"
        ],
        "ignoredPaths": ["testdata/", "vendor/", "_*/"]
      },
      "invocation": {
        "executables": [
          {
            "id": "selected",
            "kind": "setting",
            "settingID": "goExecutable"
          },
          {
            "id": "toolchain",
            "kind": "toolchain",
            "toolchainID": "go"
          },
          {
            "id": "path",
            "kind": "runtime",
            "runtime": "go"
          }
        ],
        "runtimeDependencies": [
          {
            "id": "go",
            "minimumVersion": "1.21"
          }
        ]
      },
      "options": [
        {
          "id": "tags",
          "displayName": "Build Tags",
          "kind": "text",
          "arguments": [
            "-tags",
            "${value}"
          ]
        },
        {
          "id": "race",
          "displayName": "Race Detector",
          "kind": "boolean",
          "arguments": [
            "-race"
          ]
        }
      ],
      "model": {
        "source": "command",
        "arguments": [
          "list",
          "-json",
          "./..."
        ],
        "decoder": "jsonStream",
        "executesProjectCode": false,
        "mayUseNetwork": true,
        "map": {
          "projects": [
            {
              "each": "/0/Module",
              "name": "/Path",
              "path": "/Dir",
              "properties": {
                "goVersion": "/GoVersion"
              },
              "targets": [
                {
                  "each": "$/*",
                  "where": [
                    {
                      "pointer": "/Name",
                      "equals": "main"
                    }
                  ],
                  "name": "/ImportPath",
                  "path": "/Dir",
                  "tags": [
                    "application"
                  ],
                  "properties": {
                    "short": {
                      "from": "/ImportPath",
                      "transform": "lastSegment"
                    }
                  }
                },
                {
                  "each": "$/*",
                  "where": [
                    {
                      "pointer": "/TestGoFiles",
                      "exists": true
                    }
                  ],
                  "name": "/ImportPath",
                  "path": "/Dir",
                  "tags": [
                    "test"
                  ]
                }
              ]
            }
          ]
        }
      },
      "tasks": [
        {
          "id": "build",
          "displayName": "Build",
          "group": "build",
          "scopes": [
            "project"
          ],
          "arguments": [
            "build",
            "${optionArguments}",
            "./..."
          ]
        },
        {
          "id": "vet",
          "displayName": "Vet",
          "group": "verification",
          "scopes": [
            "project",
            "target"
          ],
          "arguments": [
            "vet",
            "${optionArguments}",
            {
              "value": "./...",
              "when": "noTargetSelected"
            },
            {
              "value": "${target.name}",
              "when": "targetSelected"
            }
          ]
        }
      ],
      "run": [
        {
          "id": "main",
          "fromTargets": {
            "tags": [
              "application"
            ]
          },
          "name": "${target.property:short}",
          "arguments": [
            "run",
            "${optionArguments}",
            "${target.name}"
          ]
        }
      ],
      "runConfigurationTypes": [
        {
          "id": "build",
          "displayName": "Go Build",
          "description": "Builds and runs a Go package, file or directory with go run.",
          "icon": {
            "path": "icons/go-build.svg",
            "darkPath": "icons/go-build-dark.svg",
            "mode": "original"
          },
          "fields": [
            {
              "id": "runKind",
              "title": "Run kind",
              "kind": "choice",
              "default": "package",
              "choices": [
                {
                  "value": "package",
                  "title": "Package"
                },
                {
                  "value": "file",
                  "title": "File"
                },
                {
                  "value": "directory",
                  "title": "Directory"
                }
              ]
            },
            {
              "id": "package",
              "title": "Package path",
              "description": "The import path of a main package, or a path relative to the working directory such as ./cmd/server.",
              "kind": "text",
              "placeholder": "example.com/app/cmd/server",
              "required": true,
              "visibleWhen": {
                "field": "runKind",
                "equals": "package"
              }
            },
            {
              "id": "file",
              "title": "File",
              "description": "A .go file of a main package; go run builds only this file.",
              "kind": "file",
              "required": true,
              "visibleWhen": {
                "field": "runKind",
                "equals": "file"
              }
            },
            {
              "id": "directory",
              "title": "Directory",
              "description": "The directory of a main package.",
              "kind": "directory",
              "required": true,
              "visibleWhen": {
                "field": "runKind",
                "equals": "directory"
              }
            },
            {
              "id": "goToolArguments",
              "title": "Go tool arguments",
              "description": "Passed to go run before the package, such as -mod=vendor.",
              "kind": "arguments"
            }
          ],
          "arguments": [
            "run",
            "${optionArguments}",
            "${field:goToolArguments}",
            "${field:package}",
            "${field:file}",
            "${field:directory}",
            "${userArguments}"
          ]
        },
        {
          "id": "test",
          "displayName": "Go Test",
          "description": "Runs go test on a package or on every package below a directory.",
          "icon": {
            "path": "icons/go-test.svg",
            "darkPath": "icons/go-test-dark.svg",
            "mode": "original"
          },
          "execution": "task",
          "fields": [
            {
              "id": "testKind",
              "title": "Test kind",
              "kind": "choice",
              "default": "package",
              "choices": [
                {
                  "value": "directory",
                  "title": "Directory"
                },
                {
                  "value": "package",
                  "title": "Package"
                }
              ]
            },
            {
              "id": "package",
              "title": "Package path",
              "description": "An import path or a package pattern relative to the working directory; ./... tests every package below it.",
              "kind": "text",
              "default": "./...",
              "required": true,
              "visibleWhen": {
                "field": "testKind",
                "equals": "package"
              }
            },
            {
              "id": "directory",
              "title": "Directory",
              "description": "Tests every package in this directory and below it.",
              "kind": "directory",
              "required": true,
              "visibleWhen": {
                "field": "testKind",
                "equals": "directory"
              },
              "arguments": [
                "${value}/..."
              ]
            },
            {
              "id": "pattern",
              "title": "Pattern",
              "description": "A regular expression of the tests to run, passed as -run; empty runs every test.",
              "kind": "text",
              "placeholder": "^TestName$",
              "arguments": [
                "-run",
                "${value}"
              ]
            },
            {
              "id": "goToolArguments",
              "title": "Go tool arguments",
              "description": "Passed to go test before the package, such as -v or -count=1.",
              "kind": "arguments"
            }
          ],
          "arguments": [
            "test",
            "${optionArguments}",
            "${field:goToolArguments}",
            "${field:pattern}",
            "${field:package}",
            "${field:directory}",
            "${userArguments}"
          ]
        }
      ],
      "test": {
        "scopes": [
          "project",
          "target"
        ],
        "filters": [
          "case"
        ],
        "arguments": [
          "test",
          "${optionArguments}",
          {
            "value": "./...",
            "when": "noTargetSelected"
          },
          {
            "value": "${target.name}",
            "when": "targetSelected"
          },
          {
            "value": "-run",
            "when": "caseSelected"
          },
          {
            "value": "^${test.case:regex}$",
            "when": "caseSelected"
          }
        ]
      },
      "diagnostics": {
        "decoder": "lineMatcher",
        "patterns": [
          {
            "regex": "^(\\S+\\.go):(\\d+):(?:(\\d+):)? (.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4,
            "defaultSeverity": "error"
          }
        ]
      },
      "dependencies": {
        "source": "command",
        "scopes": [
          "project"
        ],
        "arguments": [
          "list",
          "-m",
          "-json",
          "all"
        ],
        "decoder": "jsonStream",
        "executesProjectCode": false,
        "mayUseNetwork": true,
        "map": {
          "each": "/*",
          "where": [
            {
              "pointer": "/Main",
              "exists": false
            }
          ],
          "name": "/Path",
          "version": "/Version",
          "properties": {
            "indirect": "/Indirect"
          }
        }
      },
      "sync": {
        "watch": [
          "go.mod",
          "go.sum",
          "go.work"
        ]
      }
    }
  ],
  "debugAdapters": [
    {
      "id": "delve",
      "displayName": "Go (Delve)",
      "adapterID": "go",
      "requests": [
        "launch"
      ],
      "selectors": [
        {
          "targetKinds": [
            "file"
          ],
          "languageIDs": [
            "go"
          ]
        }
      ],
      "configurationTypes": [
        "go"
      ],
      "configurations": {
        "launch": {
          "arguments": {
            "mode": "debug",
            "program": ".",
            "env": {
              "GO111MODULE": "auto"
            }
          },
          "targetBindings": {
            "cwd": "target.directory",
            "args": "target.arguments",
            "adapterArguments": {
              "dlvCwd": "target.directory",
              "env.PWD": "target.directory"
            }
          }
        }
      },
      "launch": {
        "executableSetting": "delveExecutable",
        "process": {
          "launch": {
            "kind": "systemCommand",
            "commands": [
              "dlv"
            ]
          },
          "arguments": [
            "dap"
          ]
        },
        "transport": "tcpAnnounced",
        "endpoint": {
          "stream": "stdout",
          "prefix": "DAP server listening at: ",
          "value": "hostPort"
        }
      }
    }
  ],
  "toolDefinitions": [
    {
      "id": "go",
      "displayName": "Go",
      "icon": {
        "host": "plugin"
      },
      "executableLayouts": [
        {
          "path": "bin/go",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "path": "bin/go.exe",
          "platforms": [
            "windows"
          ]
        }
      ],
      "executables": [
        {
          "id": "pinned",
          "kind": "setting",
          "settingID": "executable",
          "layer": "project"
        },
        {
          "id": "project-request",
          "kind": "toolchain",
          "scope": "project"
        },
        {
          "id": "default",
          "kind": "setting",
          "settingID": "executable",
          "layer": "global"
        },
        {
          "id": "global-request",
          "kind": "toolchain",
          "scope": "global"
        },
        {
          "id": "home",
          "kind": "environment",
          "variable": "GOROOT",
          "path": "bin/go",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "id": "home-windows",
          "kind": "environment",
          "variable": "GOROOT",
          "path": "bin/go.exe",
          "platforms": [
            "windows"
          ]
        },
        {
          "id": "shell",
          "kind": "command",
          "command": "go"
        },
        {
          "id": "detected",
          "kind": "toolchain",
          "scope": "installed"
        }
      ],
      "version": {
        "arguments": [
          "version"
        ],
        "pattern": "go version (?:devel )?go(\\d+(?:\\.\\d+)*)"
      },
      "discovery": [
        {
          "root": {
            "kind": "absolute",
            "path": "/usr/local"
          },
          "pattern": "go",
          "platforms": [
            "macos",
            "linux"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/opt/homebrew/Cellar"
          },
          "pattern": "go/*/libexec",
          "platforms": [
            "macos"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/opt/homebrew/Cellar"
          },
          "pattern": "go@*/*/libexec",
          "platforms": [
            "macos"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/usr/local/Cellar"
          },
          "pattern": "go/*/libexec",
          "platforms": [
            "macos"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/usr/local/Cellar"
          },
          "pattern": "go@*/*/libexec",
          "platforms": [
            "macos"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/home/linuxbrew/.linuxbrew/Cellar"
          },
          "pattern": "go/*/libexec",
          "platforms": [
            "linux"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/usr/lib"
          },
          "pattern": "go",
          "platforms": [
            "linux"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "/usr/lib"
          },
          "pattern": "go-*",
          "platforms": [
            "linux"
          ]
        },
        {
          "root": {
            "kind": "absolute",
            "path": "C:\\Program Files"
          },
          "pattern": "Go",
          "platforms": [
            "windows"
          ]
        },
        {
          "root": {
            "kind": "home"
          },
          "pattern": "scoop/apps/go/*",
          "platforms": [
            "windows"
          ]
        },
        {
          "root": {
            "kind": "home"
          },
          "pattern": "sdk/go*"
        },
        {
          "root": {
            "kind": "home"
          },
          "pattern": "go/go*"
        }
      ],
      "homeVariable": "GOROOT",
      "commands": [
        "go"
      ],
      "pathPrepend": [
        "${home}/bin"
      ],
      "launch": [
        "${executable}",
        "${arguments}"
      ]
    }
  ],
  "projectGenerators": [
    {
      "id": "go-module",
      "displayName": "Go",
      "description": "A Go module built with the go command.",
      "section": "project",
      "order": 30,
      "icon": {
        "path": "icons/go-project.svg",
        "mode": "original"
      },
      "fields": [
        {
          "id": "goroot",
          "type": "tool",
          "title": "GOROOT",
          "description": "The Go installation the project builds and runs with. The project keeps this choice.",
          "tool": "go",
          "minimumVersion": "1.21",
          "pinAs": "project",
          "optional": true
        },
        {
          "id": "addSampleCode",
          "type": "boolean",
          "title": "Add sample code",
          "default": true
        },
        {
          "id": "modulePath",
          "type": "text",
          "title": "Module path",
          "description": "The module line of go.mod: the import path other code uses for this module, such as example.com/hello or github.com/you/hello.",
          "default": "${project.name|lower}",
          "pattern": "[A-Za-z0-9_~][A-Za-z0-9._~-]*(/[A-Za-z0-9_~][A-Za-z0-9._~-]*)*",
          "maxLength": 200
        },
        {
          "id": "goVersion",
          "type": "text",
          "title": "Go version",
          "description": "The go line of go.mod: the oldest Go release the module needs. It starts as the version of the GOROOT above; a newer Go builds the module too.",
          "advanced": true,
          "default": "${field.goroot.version}",
          "pattern": "1\\.[0-9]+(\\.[0-9]+)?",
          "maxLength": 16
        }
      ],
      "requirements": [
        {
          "languageID": "go"
        },
        {
          "buildSystemID": "go"
        }
      ],
      "steps": [
        {
          "kind": "files",
          "source": "templates/go/module"
        },
        {
          "kind": "files",
          "source": "templates/go/sample",
          "when": {
            "field": "addSampleCode",
            "equals": true
          }
        }
      ],
      "openFiles": [
        {
          "path": "main.go",
          "when": {
            "field": "addSampleCode",
            "equals": true
          }
        },
        {
          "path": "go.mod",
          "when": {
            "field": "addSampleCode",
            "equals": false
          }
        }
      ]
    }
  ],
  "commandInstallers": [
    {
      "id": "gopls",
      "commands": [
        "gopls"
      ],
      "tool": "go",
      "minimumVersion": "1.21",
      "arguments": [
        "install",
        "golang.org/x/tools/gopls@latest"
      ],
      "mayUseNetwork": true,
      "targets": {
        "managed": {
          "environment": {
            "GOBIN": "${installDirectory}"
          }
        },
        "toolDefault": {
          "directory": [
            {
              "arguments": [
                "env",
                "GOBIN"
              ]
            },
            {
              "arguments": [
                "env",
                "GOPATH"
              ],
              "pathList": true,
              "append": "bin"
            }
          ]
        }
      }
    },
    {
      "id": "dlv",
      "commands": [
        "dlv"
      ],
      "tool": "go",
      "minimumVersion": "1.21",
      "arguments": [
        "install",
        "github.com/go-delve/delve/cmd/dlv@latest"
      ],
      "mayUseNetwork": true,
      "targets": {
        "managed": {
          "environment": {
            "GOBIN": "${installDirectory}"
          }
        },
        "toolDefault": {
          "directory": [
            {
              "arguments": [
                "env",
